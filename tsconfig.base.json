{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "inlineSourceMap": true,
    "inlineSources": true,
    "lib": ["es2020"],
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./lib",
    "strict": true,
    "strictPropertyInitialization": false,
    "target": "ES2020",
    "types": ["node", "jest"]
  }
}
