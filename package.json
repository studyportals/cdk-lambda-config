{
  "name": "@studyportals/cdk-lambda-config",
  "version": "1.0.0",
  "description": "CDK Construct for adding config.json file to a Lambda Function",
  "repository": {
    "type": "git",
    "url": "https://github.com/studyportals/cdk-lambda-config"
  },
  "scripts": {
    "build": "rimraf dist && webpack && tsc",
    "watch": "tsc -w",
    "test": "jest",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "npm run build && husky install"
  },
  "keywords": [
    "cdk",
    "lambda",
    "config"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "dist/**/*",
    "lib/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@aws-cdk/assert": "2.68.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@types/adm-zip": "^0.5.8",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "adm-zip": "^0.5.17",
    "aws-cdk-lib": "^2.252.0",
    "axios": "^1.16.0",
    "constructs": "^10.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-cdk-snapshot": "^2.3.6",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1041.0",
    "@aws-sdk/client-lambda": "^3.1041.0",
    "@aws-sdk/lib-dynamodb": "^3.1041.0"
  }
}
